# Copie para .env.local e preencha. Nada aqui é segredo de verdade:
# tudo isso vai para dentro do JavaScript da página.

# Onde o lead do formulário é gravado. Se ficar vazio, o formulário
# abre o WhatsApp com a mensagem pronta — nenhum contato se perde.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ID do pixel do Meta. Vazio = nenhum script de rastreio é carregado.
VITE_PIXEL_META=
